# Example environment configuration file for Sitodo application
# Copy this file to /opt/sitodo/config/app.env and customize as needed

# Server configuration
SERVER_PORT=8080

# Database configuration (H2 by default, configure for PostgreSQL/MySQL as needed)
SPRING_DATASOURCE_URL=jdbc:h2:file:/opt/sitodo/data/sitodo
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# JPA/Hibernate settings
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# Logging configuration
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_EXAMPLE_SITODO=INFO
LOGGING_FILE_NAME=/var/log/sitodo/application.log

# Profile (production, development, etc.)
SPRING_PROFILES_ACTIVE=production
